<?xml version="1.0" encoding="utf-8"?>
<!-- Hors ligne uniquement : aucune dépendance n'est téléchargée. Le seul paquet externe est le SDK WebView2, à la même
     version que DOMENIA (Microsoft.Web.WebView2 1.0.4258.31). Il doit être fourni localement (vendor/nuget) avec son
     SHA-256, comme dans le kit DOMENIA. Le runtime .NET et le moteur WebView2 fixe sont publiés depuis le cache local
     de la machine de build, jamais depuis Internet. -->
<configuration>
  <packageSources>
    <clear />
    <add key="vendor" value="vendor/nuget" />
    <add key="cache" value="C:\FilproDev\cache\nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="vendor">
      <package pattern="System.*" />
      <package pattern="Microsoft.Web.WebView2" />
    </packageSource>
    <packageSource key="cache">
      <package pattern="Microsoft.NETCore.App.*" />
      <package pattern="Microsoft.WindowsDesktop.App.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
