<?xml version="1.0" encoding="utf-8"?>
<!-- Utilisé uniquement par Validate-Windows.ps1 avec -AllowNetworkRestore.
     La configuration hors ligne du produit reste v2/NuGet.config. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Web.WebView2" />
      <package pattern="Microsoft.NETCore.App.*" />
      <!-- Outil SDK requis pour la publication EXE autonome unique ; aucune dépendance métier ajoutée. -->
      <package pattern="Microsoft.NET.ILLink.Tasks" />
      <package pattern="Microsoft.WindowsDesktop.App.*" />
      <package pattern="Microsoft.AspNetCore.App.*" />
      <package pattern="System.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
